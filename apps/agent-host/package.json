    "@covenant/memory": "workspace:*",
    "@hono/node-server": "^1.19.9",
    "@hono/node-ws": "^1.3.1",
    "hono": "^4.13.5",
    "pino": "^10.1.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@covenant/gateway-svc": "workspace:*",
    "@types/node": "^26.4.0",
    "@types/ws": "^8.18.1",
    "vitest": "^4.1.11"
  }
